BASE_APP_IMAGE=base-app-3:local
APP_PORT=8080

# Laravel runtime
APP_NAME="Base App 3"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Vue/Vite build arguments
VITE_CLIENT_ID=
VITE_ISSUER_LOGIN=https://login.cultura.gob.sv
VITE_AUTHORIZE_URL=https://login.cultura.gob.sv/oauth/authorize
VITE_TOKEN_ENDPOINT=https://login.cultura.gob.sv/oauth/token
VITE_USER_API_ENDPOINT=https://login.cultura.gob.sv/api/user
VITE_REDIRECT_URI=http://localhost:8080/callback
VITE_API_GATEWAY_URL=

# Leave empty to route the frontend to Laravel in the same container.
VITE_BACKEND_URL=
